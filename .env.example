# SprintFlow Environment Variables Template
# Copy this file to .env.local for local development.
# Do NOT commit .env or .env.local to version control.

# Google Gemini API key for AI task breakdown
# Obtain from https://aistudio.google.com/
GEMINI_API_KEY=

# PostgreSQL Database connection string (optional for local fallback to db.json)
# Format: postgres://username:password@hostname:port/database_name?sslmode=require
DATABASE_URL=
